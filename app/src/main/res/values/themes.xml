<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Desafio2DSM" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Azul Oscuro Theme -->
        <item name="colorPrimary">@color/primary_dark_blue</item>
        <item name="colorOnPrimary">@color/surface_white</item>
        <item name="colorPrimaryContainer">@color/light_blue_bg</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark_blue</item>

        <item name="colorSecondary">@color/tertiary_blue</item>
        <item name="colorOnSecondary">@color/surface_white</item>
        <item name="colorSecondaryContainer">@color/light_blue_bg</item>
        <item name="colorOnSecondaryContainer">@color/secondary_dark_blue</item>

        <item name="colorTertiary">@color/tertiary_blue</item>
        <item name="colorOnTertiary">@color/surface_white</item>

        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <item name="colorError">@color/error_red</item>
        <item name="colorOnError">@color/surface_white</item>
    </style>

    <style name="Theme.Desafio2DSM" parent="Base.Theme.Desafio2DSM" />
</resources>